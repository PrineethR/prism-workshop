---
import Simple from '../layouts/Simple.astro';
import { formulas, formulaAnswers, formulaPlan, type FormulaLength } from '../data/formula';
import { fmtClock, type Part, type PrepItem } from '../scripts/copilot/engine';
import { find, slugOf } from '../data/catalog';
import { phaseById } from '../data/phases';
import { u, img } from '../lib/url';

const lengths: FormulaLength[] = ['day', 'two'];
const data = lengths.map((l) => {
  const a = formulaAnswers(l);
  const plan = formulaPlan(l);
  const blocks = plan.days.flat();
  const end = plan.days.map((d) => { const last = d.at(-1)!; return fmtClock((last.start ?? 0) + last.minutes); });
  const phaseNames = a.phases.map((p) => phaseById[p].short);
  return { l, f: formulas[l], a, plan, blocks, end, phaseNames,
    before: plan.prep.filter((p) => p.offset < 0), after: plan.prep.filter((p) => p.offset >= 0) };
});

const when = (o: number) => {
  if (o === 0) return 'On the day';
  if (o === 1) return 'The day after';
  if (o > 1) return o % 7 === 0 ? `Week ${o / 7 + 1}` : `${o} days after`;
  const d = -o;
  return d % 7 === 0 ? `${d / 7} ${d === 7 ? 'week' : 'weeks'} before` : `${d} days before`;
};
/** Group the countdown by when, keeping order. */
const byWhen = (list: PrepItem[]) => list.reduce<{ when: string; items: PrepItem[] }[]>((g, p) => {
  const w = when(p.offset);
  const last = g.at(-1);
  if (last && last.when === w) last.items.push(p); else g.push({ when: w, items: [p] });
  return g;
}, []);

const partLabel: Record<Part['type'], string> = {
  feel: 'Activity', theory: 'Teach', cases: 'Cases', practice: 'Practice', energiser: 'Energiser', setup: 'Set-up', share: 'Share', close: 'Close',
};
const partHref = (p: Part) => { const it = p.item ? find(p.item) : undefined; return it ? u(`catalog/${slugOf(it)}/`) : undefined; };
const blockIcon: Record<string, string> = { kickoff: 'hourglass', discover: 'look', define: 'question', ideate: 'beyond', delight: 'donuts', prototype: 'build', close: 'flowers' };
---
<Simple title="Workshop" active="workshop" description="The ready-made Prism workshop, one day or two: what to do before, on the day and after.">
  <section class="w-hero wrap">
    <p class="eyebrow">Workshop · the formula</p>
    <h1>Pick a length. <em>Run it as written.</em></h1>
    <p class="lede">Two ready-made workshops, built and tested by the core design team. You don’t design anything: choose one, follow the steps below, and send us the plan for a 30-minute review before the day.</p>

    <div class="pick" role="radiogroup" aria-label="Workshop length">
      {data.map(({ l, f, plan, end, phaseNames }) => (
        <button class="pick-card" role="radio" aria-checked={l === 'day' ? 'true' : 'false'} data-pick={l}>
          <span class="pick-top">
            <span class="radio" aria-hidden="true"></span>
            <strong>{f.label}</strong>
            <span class="chip">{plan.days.length === 1 ? `09:30–${end[0]}` : `2 × 09:30–${end[0]}`}</span>
          </span>
          <span class="pick-line">{f.line}</span>
          <span class="pick-phases">{phaseNames.join(' → ')}</span>
        </button>
      ))}
    </div>
  </section>

  {data.map(({ l, f, a, plan, end, before, after }) => (
    <article class="formula wrap" data-formula={l} hidden={l !== 'day'} aria-label={f.title}>
      <div class="facts">
        <div><span>Who</span><strong>{a.people} people</strong><small>{plan.tables} tables of 6</small></div>
        <div><span>Design leads</span><strong>{a.leads}</strong><small>one per table, roughly</small></div>
        <div><span>Hours</span><strong>{plan.days.length === 1 ? `09:30–${end[0]}` : `Two days`}</strong><small>{plan.days.length === 1 ? 'with lunch and a break' : `09:30–${end[0]} and 09:30–${end[1]}`}</small></div>
        <div><span>Best for</span><strong class="best">{f.best[0]}</strong><small>{f.best.slice(1).join(' · ')}</small></div>
      </div>

      <div class="actions no-print">
        <a class="btn" href={u(`wall/?start=${l}`)}>Put it on the planning wall <span class="arrow">→</span></a>
        <button class="btn ghost" data-print>Print the run sheet</button>
      </div>

      <ol class="steps">
        <!-- 1. Before ─────────────────────────────────────────────── -->
        <li class="step">
          <div class="step-head">
            <span class="num">1</span>
            <div>
              <h2>Get ready</h2>
              <p class="muted">Start four weeks out. Each line is one job; tick them off as you go.</p>
            </div>
          </div>
          <div class="prep">
            {byWhen(before).map((g) => (
              <div class="prep-group">
                <p class="when">{g.when}</p>
                <ul>
                  {g.items.map((p) => (
                    <li><label><input type="checkbox" data-tick={`${l}:${p.offset}:${p.text.slice(0, 24)}`} /><span>{p.text}</span></label>{p.tag && <span class="tag">{p.tag}</span>}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </li>

        <!-- 2. On the day ─────────────────────────────────────────── -->
        <li class="step">
          <div class="step-head">
            <span class="num">2</span>
            <div>
              <h2>Run the {plan.days.length === 1 ? 'day' : 'two days'}</h2>
              <p class="muted">Every phase follows the same rhythm: an activity to feel it, a short why-what-how, then practice on the brief. Open a block to see what happens in it.</p>
            </div>
          </div>
          {plan.days.map((day, d) => (
            <div class="day">
              {plan.days.length > 1 && <h3 class="day-label">Day {d + 1}</h3>}
              <ol class="agenda">
                {day.map((b) => b.kind === 'break' || b.kind === 'lunch' ? (
                  <li class:list={['row', 'pause', b.kind]}>
                    <span class="time">{fmtClock(b.start ?? 0)}</span>
                    <span class="pause-label">{b.title} · {b.minutes} min</span>
                  </li>
                ) : (
                  <li class="row">
                    <span class="time">{fmtClock(b.start ?? 0)}</span>
                    <details class="block">
                      <summary>
                        <img src={img(`icons/${blockIcon[b.phase ?? 'close'] ?? 'flowers'}.webp`)} alt="" loading="lazy" />
                        <span class="b-title">{b.title}</span>
                        <span class="b-min">{b.minutes} min</span>
                        <svg class="caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
                      </summary>
                      <ul class="parts">
                        {b.parts.map((p) => {
                          const href = partHref(p);
                          return (
                            <li class={`part ${p.type}`}>
                              <span class="p-type">{partLabel[p.type]}</span>
                              <span class="p-body">
                                {href ? <a href={href}>{p.label}</a> : <span>{p.label}</span>}
                                {p.note && <small>{p.note}</small>}
                              </span>
                              <span class="p-min">{p.minutes}′</span>
                            </li>
                          );
                        })}
                      </ul>
                      {b.why && <p class="why"><strong>Why it’s here:</strong> {b.why}</p>}
                    </details>
                  </li>
                ))}
                <li class="row pause end"><span class="time">{end[d]}</span><span class="pause-label">{d === plan.days.length - 1 ? 'Done' : 'End of day 1'}</span></li>
              </ol>
            </div>
          ))}
        </li>

        <!-- 3. Outcomes ───────────────────────────────────────────── -->
        <li class="step">
          <div class="step-head">
            <span class="num">3</span>
            <div>
              <h2>What each team leaves with</h2>
              <p class="muted">{plan.success}</p>
            </div>
          </div>
          <ul class="outcomes">
            {plan.outcomes.map((o) => { const [k, ...rest] = o.split(': '); return <li>{rest.length ? <><strong>{k}</strong>{rest.join(': ')}</> : o}</li>; })}
          </ul>
        </li>

        <!-- 4. After ──────────────────────────────────────────────── -->
        <li class="step">
          <div class="step-head">
            <span class="num">4</span>
            <div>
              <h2>Follow up</h2>
              <p class="muted">The workshop is the start. These keep teams going afterwards.</p>
            </div>
          </div>
          <div class="prep">
            {byWhen(after).map((g) => (
              <div class="prep-group">
                <p class="when">{g.when}</p>
                <ul>{g.items.map((p) => <li><label><input type="checkbox" data-tick={`${l}:${p.offset}:${p.text.slice(0, 24)}`} /><span>{p.text}</span></label></li>)}</ul>
              </div>
            ))}
          </div>
        </li>
      </ol>

      <section class="need">
        <div class="need-col">
          <h2>Print these</h2>
          <p class="muted small">One set per table, plus spares. All in the toolkit.</p>
          <ul class="tpl">
            {plan.templates.map((t) => (
              <li><a href={u(`catalog/${slugOf(t)}/`)}>{t.image && <img src={img(t.image)} alt="" loading="lazy" />}<span>{t.title}</span>{t.format && <small>{t.format}</small>}</a></li>
            ))}
          </ul>
        </div>
        <div class="need-col">
          <h2>Pack these</h2>
          <ul class="mat">{plan.materials.map((m) => <li>{m}</li>)}</ul>
        </div>
      </section>
    </article>
  ))}

  <section class="wrap diy-note">
    <p><strong>Need a different shape?</strong> The formula is the format, and teams fit it to their room. If your workshop really needs something else (half a day, remote, a live problem), the <a href={u('diy/')}>DIY kit</a> has the copilot and the full catalog.</p>
  </section>
</Simple>

<script>
  import { store } from '../scripts/store';
  const KEY = 'prism.workshop.v1';
  const saved = store.get<{ length: string; ticks: Record<string, boolean> }>(KEY, { length: 'day', ticks: {} });

  const cards = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  const formulas = [...document.querySelectorAll<HTMLElement>('[data-formula]')];
  function show(l: string) {
    cards.forEach((c) => c.setAttribute('aria-checked', String(c.dataset.pick === l)));
    formulas.forEach((f) => { f.hidden = f.dataset.formula !== l; });
    saved.length = l; store.set(KEY, saved);
    history.replaceState(null, '', `#${l === 'two' ? 'two-days' : 'one-day'}`);
  }
  cards.forEach((c) => c.addEventListener('click', () => show(c.dataset.pick!)));
  // Arrow keys move between the two options, as a radio group should.
  cards.forEach((c, i) => c.addEventListener('keydown', (e) => {
    if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(e.key)) return;
    e.preventDefault();
    const next = cards[(i + 1) % cards.length]; next.focus(); show(next.dataset.pick!);
  }));
  const fromHash = location.hash === '#two-days' ? 'two' : location.hash === '#one-day' ? 'day' : saved.length;
  show(fromHash === 'two' ? 'two' : 'day');

  // Ticks are remembered per browser, so the countdown doubles as a checklist.
  document.querySelectorAll<HTMLInputElement>('[data-tick]').forEach((box) => {
    box.checked = !!saved.ticks[box.dataset.tick!];
    box.addEventListener('change', () => { saved.ticks[box.dataset.tick!] = box.checked; store.set(KEY, saved); });
  });

  // Print opens every block of the visible formula, then puts them back.
  document.querySelectorAll('[data-print]').forEach((b) => b.addEventListener('click', () => {
    const shut = [...document.querySelectorAll<HTMLDetailsElement>('[data-formula]:not([hidden]) details:not([open])')];
    shut.forEach((d) => { d.open = true; });
    window.print();
    shut.forEach((d) => { d.open = false; });
  }));
</script>

<style>
  .w-hero { padding-block: clamp(40px, 7vw, 88px) 28px; display: grid; gap: 18px; }
  .w-hero h1 { max-width: 16ch; }

  .pick { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 12px; }
  .pick-card {
    display: grid; gap: 10px; text-align: left; padding: 20px 22px; border-radius: var(--radius); cursor: pointer;
    background: var(--surface); border: 1.5px solid var(--line);
    transition: border-color var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease), transform var(--t-fast) var(--ease);
  }
  .pick-card:hover { border-color: var(--pink-mid); transform: translateY(-1px); }
  .pick-card[aria-checked='true'] { border-color: var(--accent); box-shadow: var(--shadow-lift); background: var(--blush-2); }
  .pick-top { display: flex; align-items: center; gap: 10px; }
  .pick-top strong { font-size: 1.3rem; }
  .pick-top .chip { margin-left: auto; font-variant-numeric: tabular-nums; }
  .radio { width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--line); flex: none; position: relative; transition: border-color var(--t-base) var(--ease); }
  .radio::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--accent); transform: scale(0); transition: transform var(--t-base) var(--ease-pop); }
  [aria-checked='true'] .radio { border-color: var(--accent); }
  [aria-checked='true'] .radio::after { transform: scale(1); }
  .pick-line { color: var(--ink-2); font-size: 0.95rem; }
  .pick-phases { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; color: var(--accent); }
  @media (max-width: 680px) { .pick { grid-template-columns: 1fr; } }

  .formula { display: grid; gap: 28px; padding-bottom: 24px; }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .facts > div { display: grid; gap: 2px; padding: 16px 18px; border-left: 1px solid var(--line); }
  .facts > div:first-child { border-left: 0; }
  .facts span { font-size: 0.72rem; font-weight: 900; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); }
  .facts strong { font-size: 1.15rem; }
  .facts strong.best { font-size: 0.98rem; line-height: 1.3; }
  .facts small { color: var(--ink-2); font-size: 0.82rem; }
  @media (max-width: 820px) {
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts > div:nth-child(3) { border-left: 0; }
    .facts > div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .step { position: relative; padding: 8px 0 40px 64px; }
  .step::before { content: ''; position: absolute; left: 19px; top: 48px; bottom: 0; width: 2px; background: var(--line-2); }
  .step:last-child::before { display: none; }
  .step-head { display: flex; gap: 20px; align-items: start; margin-left: -64px; margin-bottom: 20px; }
  .num {
    flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
    background: var(--accent); color: var(--accent-ink); font-weight: 900;
  }
  .step-head h2 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); margin-bottom: 4px; }
  .step-head p { max-width: 64ch; }
  @media (max-width: 600px) {
    .step { padding-left: 0; }
    .step::before { display: none; }
    .step-head { margin-left: 0; gap: 14px; }
  }

  .prep { display: grid; gap: 18px; }
  .when { font-size: 0.75rem; font-weight: 900; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; }
  .prep ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .prep li { display: flex; align-items: start; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--line-2); }
  .prep label { display: flex; gap: 12px; align-items: start; cursor: pointer; }
  .prep input { width: 18px; height: 18px; margin-top: 3px; accent-color: var(--accent); flex: none; }
  .prep input:checked + span { color: var(--ink-3); text-decoration: line-through; text-decoration-color: var(--pink-mid); }
  .tag { font-size: 0.72rem; font-weight: 700; color: var(--ink-3); border: 1px solid var(--line); border-radius: 999px; padding: 1px 8px; white-space: nowrap; }

  .day + .day { margin-top: 28px; }
  .day-label { font-size: 1.05rem; margin-bottom: 10px; color: var(--accent); }
  .agenda { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .row { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 14px; align-items: start; }
  .time { font-variant-numeric: tabular-nums; font-weight: 700; color: var(--ink-2); padding-top: 14px; font-size: 0.92rem; }
  .pause .time { padding-top: 4px; }
  .pause-label { padding: 4px 14px; font-size: 0.88rem; color: var(--ink-2); border-left: 3px solid var(--line); }
  .pause.lunch .pause-label { border-left-color: var(--pink); }
  .pause.end .pause-label { font-weight: 700; border-left-color: var(--accent); }

  .block { border: 1px solid var(--line); border-radius: 12px; background: var(--surface); transition: box-shadow var(--t-base) var(--ease), border-color var(--t-base) var(--ease); }
  .block[open] { box-shadow: var(--shadow); border-color: var(--pink); }
  .block summary { display: flex; align-items: center; gap: 12px; padding: 10px 14px; cursor: pointer; list-style: none; }
  .block summary::-webkit-details-marker { display: none; }
  .block summary img { width: 32px; height: 32px; object-fit: contain; }
  .b-title { font-weight: 700; flex: 1; }
  .b-min { font-variant-numeric: tabular-nums; font-size: 0.85rem; color: var(--ink-2); }
  .caret { width: 14px; height: 14px; fill: none; stroke: var(--ink-3); stroke-width: 1.6; transition: transform var(--t-base) var(--ease); }
  .block[open] .caret { transform: rotate(180deg); }
  .parts { list-style: none; margin: 0; padding: 0 14px 6px; border-top: 1px solid var(--line-2); }
  .part { display: grid; grid-template-columns: 84px minmax(0, 1fr) auto; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line-2); align-items: baseline; }
  .part:last-child { border-bottom: 0; }
  .p-type { font-size: 0.7rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .part.feel .p-type, .part.energiser .p-type { color: var(--ultra); }
  .part.practice .p-type { color: var(--ok); }
  .part.theory .p-type, .part.cases .p-type { color: var(--accent); }
  .p-body { display: grid; gap: 2px; font-size: 0.95rem; }
  .p-body a { color: var(--ink); text-decoration-color: var(--pink-mid); text-underline-offset: 3px; }
  .p-body a:hover { color: var(--accent); }
  .p-body small { color: var(--ink-2); font-size: 0.84rem; }
  .p-min { font-variant-numeric: tabular-nums; font-size: 0.85rem; color: var(--ink-2); }
  .why { margin: 0 14px 14px; padding: 10px 12px; background: var(--blush-2); border-radius: 8px; font-size: 0.88rem; color: var(--ink-2); }
  @media (max-width: 520px) {
    .row { grid-template-columns: 1fr; gap: 4px; }
    .time { padding-top: 0; }
    .part { grid-template-columns: minmax(0, 1fr) auto; }
    .p-type { grid-column: 1 / -1; }
  }

  .outcomes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .outcomes li { padding: 14px 16px; border-radius: 12px; background: var(--surface-2); border: 1px solid var(--line-2); font-size: 0.95rem; color: var(--ink-2); }
  .outcomes strong { display: block; color: var(--accent); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 4px; }

  .need { display: grid; grid-template-columns: 3fr 2fr; gap: clamp(24px, 4vw, 56px); padding-top: 32px; border-top: 1px solid var(--line); }
  .need h2 { font-size: 1.4rem; margin-bottom: 4px; }
  .tpl { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .tpl a { display: grid; gap: 6px; padding: 10px; border: 1px solid var(--line); border-radius: 10px; text-decoration: none; height: 100%; transition: border-color var(--t-fast), box-shadow var(--t-base) var(--ease); }
  .tpl a:hover { border-color: var(--pink); box-shadow: var(--shadow); }
  .tpl img { aspect-ratio: 4 / 3; width: 100%; object-fit: contain; background: var(--blush-2); border-radius: 6px; }
  .tpl span { font-weight: 700; font-size: 0.88rem; line-height: 1.3; }
  .tpl small { color: var(--ink-3); font-size: 0.76rem; }
  .mat { margin: 14px 0 0; padding-left: 1.1em; display: grid; gap: 8px; color: var(--ink-2); font-size: 0.95rem; }
  @media (max-width: 820px) { .need { grid-template-columns: 1fr; } }

  .diy-note { padding-block: 24px 8px; }
  .diy-note p { padding: 16px 20px; border: 1px dashed var(--line); border-radius: var(--radius); color: var(--ink-2); max-width: 80ch; }

  @media print {
    :global(.s-head), :global(.s-foot), .w-hero, .diy-note, .need .tpl img { display: none !important; }
    .step { padding-left: 0; break-inside: auto; }
    .step::before { display: none; }
    .step-head { margin-left: 0; }
    .block { box-shadow: none; break-inside: avoid; }
  }
</style>
