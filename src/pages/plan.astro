---
import Base from '../layouts/Base.astro';
import Wall from '../components/Wall.astro';
import { u } from '../lib/url';

const starts = [
  { id: 'diamond', title: 'The Double Diamond', body: 'One frame per phase, holding the tools the deck teaches. Swap what doesn’t fit.' },
  { id: 'copilot', title: 'My copilot plan', body: 'Every block as a frame, in running order. Breaks as notes.' },
  { id: 'pins', title: 'My pinned pieces', body: 'The pieces you added from the catalog.' },
];
---
<Base title="My plan" active="plan" full description="An open wall for planning a workshop: mix and match activities, methods, cases, templates and kit pieces.">
  <Wall starts={starts}>
    <Fragment slot="foot">Saved in this browser as you go. Want a recommended agenda first? <a href={u('copilot/')}>Ask the copilot</a>.</Fragment>
  </Wall>
</Base>
