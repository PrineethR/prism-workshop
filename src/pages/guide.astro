---
import Base from '../layouts/Base.astro';
import Diamond from '../components/Diamond.astro';
import { steps, reviewChecklist } from '../data/guide';
import { modulePattern } from '../data/phases';
import { itemBySlug } from '../data/catalog';
import { u, img } from '../lib/url';
---
<Base title="Guide" active="guide" description="Ten steps from a business brief to a reviewed workshop plan.">
  <header class="wrap g-head">
    <p class="eyebrow">The guide</p>
    <h1>From a brief to a <em>reviewed plan</em>, in ten steps.</h1>
    <p class="lede">Work through these in order. Tick off each “done when” as you go. Your progress is saved in this browser.</p>
  </header>

  <div class="wrap g-body">
    <aside class="rail" aria-label="Steps">
      <div class="progress">
        <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="15.5" /><circle class="bar" cx="18" cy="18" r="15.5" pathLength="100" /></svg>
        <div><strong data-done-count>0</strong> of {steps.length} steps done</div>
      </div>
      <ol>
        {steps.map((s) => (
          <li><a href={`#${s.id}`} data-rail={s.id}><span class="n">{s.n}</span><span class="t">{s.title}</span><span class="tick" aria-hidden="true">✓</span></a></li>
        ))}
      </ol>
      <span class="rail-ink" aria-hidden="true"></span>
      <a class="btn small" href={u('copilot/')}>Open the copilot →</a>
    </aside>

    <div class="steps">
      {steps.map((s) => (
        <section class="step" id={s.id} data-step={s.id}>
          <div class="step-head">
            <span class="num">{String(s.n).padStart(2, '0')}</span>
            <img src={img(`icons/${s.icon}.webp`)} alt="" loading="lazy" />
            <div>
              <h2>{s.title}</h2>
              <p class="lede">{s.lede}</p>
            </div>
          </div>

          {s.id === 'spine' && <div class="inset"><Diamond compact={false} active={['discover', 'define', 'ideate', 'prototype']} /></div>}
          {s.id === 'module' && (
            <ol class="mini-beats">
              {modulePattern.map((b, i) => <li style={`--i:${i}`}><span>{i + 1}</span>{b.label}</li>)}
            </ol>
          )}

          <div class="cols">
            <div>
              <h3>Do</h3>
              <ul class="do">{s.do.map((d) => <li>{d}</li>)}</ul>
            </div>
            <div>
              <h3>Done when</h3>
              <ul class="checks">
                {s.done.map((d, k) => (
                  <li><label><input type="checkbox" data-check={`${s.id}:${k}`} /><span class="box" aria-hidden="true"></span><span>{d}</span></label></li>
                ))}
              </ul>
            </div>
          </div>

          <div class="prism">
            <span class="label">In Prism</span>
            <p>{s.prism}</p>
          </div>

          {s.avoid && (
            <p class="avoid"><span class="label">Avoid</span>{s.avoid.join(' · ')}</p>
          )}

          {s.id === 'review' && (
            <ul class="review">
              {reviewChecklist.map((c) => <li><span class:list={['tag', { auto: c.auto }]}>{c.auto ? 'Copilot checks' : 'You check'}</span>{c.label}</li>)}
            </ul>
          )}

          {s.links && (
            <div class="links">
              <span class="label">From the catalog</span>
              {s.links.map((slug) => {
                const it = itemBySlug[slug];
                return it && <a class="chip" href={u(`catalog/${slug}/`)}>{it.title}</a>;
              })}
            </div>
          )}
        </section>
      ))}
    </div>
  </div>
</Base>

<script>
  import { initGuide } from '../scripts/guide';
  initGuide();
</script>

<style>
  .g-head { display: grid; gap: 16px; padding-block: clamp(36px, 6vw, 72px) clamp(24px, 4vw, 40px); }
  .g-head h1 { max-width: 18ch; }

  .g-body { display: grid; grid-template-columns: 260px 1fr; gap: clamp(24px, 5vw, 72px); align-items: start; }

  .rail { position: sticky; top: calc(var(--head-h) + 20px); display: grid; gap: 18px; }
  .rail ol { list-style: none; margin: 0; padding: 0; position: relative; }
  .rail a[data-rail] {
    display: grid; grid-template-columns: 26px 1fr 16px; gap: 8px; align-items: center; padding: 7px 10px; border-radius: 8px;
    text-decoration: none; color: var(--ink-2); font-size: 0.9rem; transition: color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .rail a[data-rail]:hover { background: var(--blush-2); color: var(--ink); }
  .rail a.current { color: var(--accent); font-weight: 700; }
  .rail .n { font-weight: 900; font-size: 0.78rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .rail a.current .n { color: var(--accent); }
  .rail .tick { opacity: 0; transform: scale(0.4); color: var(--ok); font-weight: 900; transition: opacity var(--t-base), transform var(--t-base) var(--ease-pop); }
  .rail a.done .tick { opacity: 1; transform: none; }
  .rail-ink {
    position: absolute; left: 0; top: 0; width: 3px; height: 32px; border-radius: 3px; background: var(--accent);
    transition: transform var(--t-base) var(--ease), height var(--t-base) var(--ease); pointer-events: none;
  }
  .progress { display: flex; align-items: center; gap: 12px; font-size: 0.9rem; color: var(--ink-2); }
  .progress svg { width: 44px; height: 44px; transform: rotate(-90deg); }
  .progress circle { fill: none; stroke: var(--line); stroke-width: 3.5; }
  .progress .bar { stroke: var(--accent); stroke-linecap: round; stroke-dasharray: 0 100; transition: stroke-dasharray var(--t-slow) var(--ease); }
  .progress strong { color: var(--accent); font-size: 1.1rem; }

  .steps { display: grid; gap: 0; min-width: 0; }
  .step { padding-block: 40px 56px; border-top: 1px solid var(--line); display: grid; gap: 24px; }
  .step:first-child { border-top: 0; padding-top: 0; }
  .step-head { display: grid; grid-template-columns: auto 88px 1fr; gap: 20px; align-items: center; }
  .num { font-size: clamp(2.6rem, 5vw, 4rem); font-weight: 900; font-style: italic; color: var(--pink); line-height: 0.9; font-variant-numeric: tabular-nums; }
  .step-head img { width: 88px; height: 88px; object-fit: contain; }
  .step-head h2 { font-size: clamp(1.5rem, 2.6vw, 2.1rem); }
  .step-head .lede { margin-top: 6px; font-size: 1.05rem; }

  .cols { display: grid; grid-template-columns: 1.2fr 1fr; gap: 28px; }
  .cols h3 { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-3); margin-bottom: 10px; font-weight: 900; }
  .do { margin: 0; padding-left: 1.1em; display: grid; gap: 8px; }
  .do li::marker { color: var(--accent); }
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .checks label { display: grid; grid-template-columns: 22px 1fr; gap: 10px; cursor: pointer; align-items: start; }
  .checks input { position: absolute; opacity: 0; pointer-events: none; }
  .box {
    width: 22px; height: 22px; border-radius: 6px; border: 2px solid var(--pink-mid); display: grid; place-items: center; margin-top: 1px;
    transition: background var(--t-fast) var(--ease), border-color var(--t-fast), transform var(--t-base) var(--ease-pop);
  }
  .box::after { content: ''; width: 10px; height: 6px; border: solid #fff; border-width: 0 0 2.5px 2.5px; transform: rotate(-45deg) scale(0); margin-top: -3px; transition: transform var(--t-base) var(--ease-pop); }
  .checks input:checked + .box { background: var(--accent); border-color: var(--accent); transform: scale(1.08); }
  .checks input:checked + .box::after { transform: rotate(-45deg) scale(1); }
  .checks input:checked ~ span:last-child { color: var(--ink-3); text-decoration: line-through; text-decoration-color: var(--pink-mid); }
  .checks input:focus-visible + .box { outline: 2px solid var(--accent); outline-offset: 2px; }

  .label { display: inline-block; font-size: 0.72rem; font-weight: 900; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-right: 10px; }
  .prism { padding: 18px 20px; border-radius: 12px; background: var(--blush-2); border-left: 4px solid var(--accent); }
  .prism p { margin-top: 4px; font-style: italic; }
  .avoid { color: var(--ink-2); font-size: 0.95rem; }
  .avoid .label { color: var(--warn); }
  .links { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .links .chip { text-decoration: none; transition: background var(--t-fast), transform var(--t-fast) var(--ease); }
  .links .chip:hover { background: var(--pink); transform: translateY(-1px); }

  .inset { padding: 8px 0; max-width: 720px; }
  .mini-beats { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .mini-beats li { display: inline-flex; gap: 8px; align-items: center; padding: 6px 12px 6px 6px; border-radius: 999px; border: 1px solid var(--line); font-size: 0.85rem; font-weight: 700; }
  .mini-beats span { width: 22px; height: 22px; border-radius: 50%; background: var(--blush); color: var(--accent); display: grid; place-items: center; font-size: 0.72rem; }

  .review { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .review li { display: flex; gap: 12px; align-items: center; padding: 10px 14px; border: 1px solid var(--line); border-radius: 10px; }
  .review .tag { flex: none; font-size: 0.7rem; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 8px; border-radius: 999px; background: var(--surface-2); color: var(--ink-2); }
  .review .tag.auto { background: var(--blush); color: var(--accent); }

  @media (max-width: 900px) {
    .g-body { grid-template-columns: 1fr; }
    .rail { position: static; display: none; }
    .cols { grid-template-columns: 1fr; }
    .step-head { grid-template-columns: auto 1fr; }
    .step-head img { display: none; }
  }
</style>
