---
import Base from '../layouts/Base.astro';
import { u, img } from '../lib/url';

// Phase 1: two tools up front, everything else is reference.
const tools = [
  {
    href: 'copilot/', title: 'Copilot', icon: 'spaceship', cta: 'Plan a workshop',
    line: 'Say what the workshop is for. Get a one-day or two-day agenda that already passes the review checks.',
    gets: ['Agenda, block by block', 'Prep countdown', 'Facilitator’s run sheet'],
  },
  {
    href: 'plan/', title: 'My plan', icon: 'map', cta: 'Open my plan',
    line: 'Lay the day out on a wall. Bring in the copilot’s agenda and move, swap or retime anything.',
    gets: ['Frames that add up the time', 'Any activity or template as a card', 'Copy it as a list for your team'],
  },
];

const reference = [
  { href: 'guide/', title: 'Guide', line: 'The ten steps, from a brief to a reviewed plan.' },
  { href: 'catalog/', title: 'Catalog', line: 'Every activity, method, case and template.' },
  { href: 'kit/', title: 'Kit', line: 'The deck, toolkit and guidebook.' },
  { href: 'editions/monsoon/', title: 'Monsoon Edition', line: 'How the last two-day run went.' },
];
---
<Base title="Prism" active="home">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>Prism · Workshop kit</p>
        <h1 data-reveal style="--i:1">Plan a one- or two-day <em>Prism workshop.</em></h1>
        <p class="lede" data-reveal style="--i:2">
          The format is set: the Double Diamond, run the way we run it. You fit it to your team and your room, and we review it before the day.
        </p>
        <div class="ctas" data-reveal style="--i:3">
          <a class="btn" href={u('copilot/')}>Plan a workshop <span class="arrow">→</span></a>
          <a class="btn ghost" href={u('plan/')}>Open my plan</a>
        </div>
      </div>
      <div class="hero-art" data-prism aria-hidden="true">
        <img class="glass" src={img('deck/glass-ribbon.webp')} alt="" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="wrap tools" aria-label="Start here">
    {tools.map((t, i) => (
      <a class="tool" href={u(t.href)} data-reveal style={`--i:${i}`}>
        <img src={img(`icons/${t.icon}.webp`)} alt="" loading="lazy" />
        <div class="tool-copy">
          <h2>{t.title}</h2>
          <p>{t.line}</p>
          <ul>{t.gets.map((g) => <li>{g}</li>)}</ul>
          <span class="go">{t.cta} <span class="arrow" aria-hidden="true">→</span></span>
        </div>
      </a>
    ))}
  </section>

  <section class="wrap how" aria-label="How it works">
    <ol class="flow">
      <li data-reveal><span>1</span><div><h3>Draft</h3><p>The copilot builds the agenda from what the workshop is for.</p></div></li>
      <li data-reveal style="--i:1"><span>2</span><div><h3>Shape</h3><p>Move it to My plan and tune it with your co-facilitators.</p></div></li>
      <li data-reveal style="--i:2"><span>3</span><div><h3>Review</h3><p>30 minutes with the core team, two weeks before the day.</p></div></li>
    </ol>
  </section>

  <section class="wrap ref" aria-labelledby="ref-h">
    <h2 id="ref-h" class="eyebrow">Reference, when you need it</h2>
    <ul>
      {reference.map((r) => (
        <li><a href={u(r.href)}><strong>{r.title}</strong><span>{r.line}</span></a></li>
      ))}
    </ul>
  </section>
</Base>

<script>
  import { initHome } from '../scripts/home';
  initHome();
</script>

<style>
  /* Hero */
  .hero { padding-block: clamp(28px, 5vw, 56px) clamp(24px, 4vw, 48px); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(24px, 4vw, 64px); align-items: center; }
  .hero-copy { display: grid; gap: 20px; }
  .hero h1 em { display: block; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }

  .hero-art { position: relative; aspect-ratio: 1 / 0.8; }
  .glass {
    position: absolute; top: 50%; left: 50%; width: 128%; max-width: none; height: auto;
    translate: -46% -50%;
    transform: translate3d(calc(var(--px, 0) * -14px), calc(var(--py, 0) * -10px), 0) rotate(calc(var(--px, 0) * -2deg));
    transition: transform 0.8s var(--ease);
    animation: enter 1.2s var(--ease) both, float 10s ease-in-out 1.2s infinite alternate;
  }
  @keyframes float { from { translate: -46% calc(-50% - 8px); } to { translate: -46% calc(-50% + 10px); } }
  @keyframes enter { from { opacity: 0; scale: 0.92; } to { opacity: 1; scale: 1; } }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-art { max-width: 420px; width: 100%; justify-self: center; order: -1; aspect-ratio: 1.6 / 1; }
    .glass { width: 112%; translate: -50% -50%; }
    @keyframes float { from { translate: -50% calc(-50% - 6px); } to { translate: -50% calc(-50% + 8px); } }
  }

  /* The two tools */
  .tools { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .tool {
    display: grid; grid-template-columns: 112px 1fr; gap: 20px; align-items: start; padding: 28px;
    border-radius: var(--radius); background: var(--blush-2); border: 1px solid var(--line-2);
    text-decoration: none; color: inherit;
    transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease), background var(--t-base) var(--ease);
  }
  .tool img { width: 112px; height: 112px; object-fit: contain; transition: transform var(--t-slow) var(--ease-pop); }
  .tool-copy { display: grid; gap: 10px; }
  .tool h2 { font-size: 1.7rem; font-weight: 700; }
  .tool p { color: var(--ink-2); }
  .tool ul { list-style: none; margin: 2px 0 6px; padding: 0; display: grid; gap: 4px; font-size: 0.92rem; color: var(--ink-2); }
  .tool li::before { content: '✓'; color: var(--accent); font-weight: 900; margin-right: 8px; }
  .tool .go { font-weight: 700; color: var(--accent); }
  .tool .arrow { display: inline-block; transition: transform var(--t-base) var(--ease); }
  .tool:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); background: var(--surface); }
  .tool:hover img { transform: translateY(-4px) rotate(-6deg) scale(1.06); }
  .tool:hover .arrow { transform: translateX(4px); }
  @media (max-width: 900px) { .tools { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .tool { grid-template-columns: 1fr; padding: 22px; } .tool img { width: 80px; height: 80px; } }

  /* How it works */
  .how { margin-top: clamp(40px, 6vw, 72px); }
  .flow { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .flow li { display: grid; grid-template-columns: 34px 1fr; gap: 14px; align-items: start; padding-top: 16px; border-top: 2px solid var(--line); }
  .flow span { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: #fff; font-weight: 900; }
  .flow h3 { font-size: 1.05rem; }
  .flow p { color: var(--ink-2); font-size: 0.95rem; }
  @media (max-width: 760px) { .flow { grid-template-columns: 1fr; } }

  /* Reference: quiet, one line each */
  .ref { margin-block: clamp(48px, 7vw, 88px) clamp(16px, 3vw, 32px); }
  .ref h2 { margin-bottom: 12px; }
  .ref ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0 16px; }
  .ref a {
    display: grid; gap: 2px; padding: 14px 0; border-top: 1px solid var(--line); text-decoration: none; color: inherit;
    transition: border-color var(--t-base) var(--ease);
  }
  .ref strong { color: var(--ink); transition: color var(--t-fast) var(--ease); }
  .ref span { font-size: 0.88rem; color: var(--ink-3); }
  .ref a:hover { border-color: var(--accent); }
  .ref a:hover strong { color: var(--accent); }
  @media (max-width: 860px) { .ref ul { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .ref ul { grid-template-columns: 1fr; } }
</style>
