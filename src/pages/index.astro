---
import Simple from '../layouts/Simple.astro';
import { kit, perspectiveCards } from '../data/kit';
import { phases } from '../data/phases';
import { items, slugOf } from '../data/catalog';
import { monsoon } from '../data/editions';
import { u, img } from '../lib/url';

// Tab 1: the shelf. The files to take away, the method on one page, every
// template, and the last run as a worked example. Nothing to decide here.
const core = phases.filter((p) => p.diamond);
const templates = items.filter((i) => i.kind === 'template');
const tplPhases = phases.filter((p) => templates.some((t) => t.phase === p.id));
---
<Simple title="Reference" active="reference">
  <section class="r-hero wrap">
    <div class="r-hero-copy">
      <p class="eyebrow">Reference · the shelf</p>
      <h1>Everything you need <em>to run a Prism workshop.</em></h1>
      <p class="lede">The deck, the toolkit and the guidebook, the method on one page, and every worksheet. When you’re ready to plan, the Workshop tab gives you a ready-made day.</p>
    </div>
    <ol class="route" aria-label="How the kit works">
      <li class="here"><span>1</span><div><strong>Reference</strong><small>The files and the method. You’re here.</small></div></li>
      <li><a href={u('wall/')}><span>2</span><div><strong>Planning wall</strong><small>Lay the day out and adjust it.</small></div></a></li>
      <li><a href={u('workshop/')}><span>3</span><div><strong>Workshop</strong><small>One day or two, ready to run.</small></div></a></li>
    </ol>
  </section>

  <nav class="wrap jump" aria-label="On this page">
    <a href="#files">The files</a><a href="#method">The method</a><a href="#templates">Templates</a><a href="#cards">Perspective cards</a><a href="#past">Past workshops</a>
  </nav>

  <!-- The files ─────────────────────────────────────────────────────────── -->
  <section class="wrap r-sec" id="files">
    <div class="r-head">
      <h2>The files</h2>
      <p class="muted">Three things to take away. Copy them in Figma; don’t edit the originals.</p>
    </div>
    <div class="files">
      {kit.map((k) => (
        <article class="file">
          <div class="file-media"><img src={img(k.poster)} alt="" loading="lazy" /></div>
          <div class="file-body">
            <h3>{k.title}</h3>
            <p>{k.line}</p>
            <ul>{k.inside.map((x) => <li>{x}</li>)}</ul>
            {k.figma
              ? <a class="btn small" href={k.figma} target="_blank" rel="noopener">Open in Figma <span class="arrow">↗</span></a>
              : <span class="soon small">Figma link to come</span>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- The method ────────────────────────────────────────────────────────── -->
  <section class="wrap r-sec" id="method">
    <div class="r-head">
      <h2>The method <em>on one page</em></h2>
      <p class="muted">Every Prism workshop follows the Double Diamond: open up the problem, narrow to one worth solving, open up ideas, narrow to one worth testing.</p>
    </div>
    <div class="method">
      <img class="dd" src={img('deck/double-diamond.webp')} alt="The Double Diamond: Discover and Define in the first diamond, Ideate and Prototype in the second." loading="lazy" />
      <ol class="phases">
        {core.map((p) => (
          <li>
            <img src={img(`icons/${p.icon}.webp`)} alt="" loading="lazy" />
            <div>
              <h3>{p.name}{p.diamond && <span class="dir">{p.diamond.half === 'diverge' ? 'open up' : 'narrow down'}</span>}</h3>
              <p class="tag">{p.tagline}</p>
              <ul>{p.cheatSheet.map((c) => <li>{c}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Templates ─────────────────────────────────────────────────────────── -->
  <section class="wrap r-sec" id="templates">
    <div class="r-head">
      <h2>Templates</h2>
      <p class="muted">{templates.length} worksheets, cards and facilitator documents. Open one for what’s on it and how to use it.</p>
    </div>
    <div class="filters" role="group" aria-label="Filter templates by phase">
      <button aria-pressed="true" data-tf="">All</button>
      {tplPhases.map((p) => <button aria-pressed="false" data-tf={p.id}>{p.short}</button>)}
    </div>
    <ul class="tpls">
      {templates.map((t) => (
        <li data-tp={t.phase}>
          <a href={u(`catalog/${slugOf(t)}/`)}>
            <span class="tpl-media">{t.image && <img src={img(t.image)} alt="" loading="lazy" />}</span>
            <strong>{t.title}</strong>
            {t.format && <small>{t.format}</small>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Perspective cards ─────────────────────────────────────────────────── -->
  <section class="wrap r-sec" id="cards">
    <div class="r-head">
      <h2>Perspective cards</h2>
      <p class="muted">One set per table. Each table argues from its card’s seat, so every idea gets four kinds of question.</p>
    </div>
    <ul class="pcards">
      {perspectiveCards.map((c) => (
        <li>
          <img src={img(c.image)} alt="" loading="lazy" />
          <div><strong>{c.title}</strong><span class="line">“{c.line}”</span><p>{c.asks}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Past workshops ───────────────────────────────────────────────────── -->
  <section class="wrap r-sec" id="past">
    <div class="r-head">
      <h2>Past workshops</h2>
      <p class="muted">How the format ran for real. Read one before your first.</p>
    </div>
    <a class="past" href={u('editions/monsoon/')}>
      <img src={img('deck/cohort-room.webp')} alt="Cohort 3 at work in Axis House, Mumbai" loading="lazy" />
      <div>
        <p class="eyebrow">{monsoon.cohort} · {monsoon.where}</p>
        <h3>{monsoon.name}</h3>
        <p class="muted">{monsoon.programme}. Two days in person, then six weeks of group projects. The two-day workshop on the Workshop tab follows this run.</p>
        <span class="go">Read the write-up <span aria-hidden="true">→</span></span>
      </div>
    </a>
    <p class="more small muted">Looking for every activity, method and case? They’re in the <a href={u('catalog/')}>full catalog</a>, part of the DIY kit.</p>
  </section>
</Simple>

<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-tf]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-tp]')];
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const f = b.dataset.tf;
    cards.forEach((c) => { c.hidden = !!f && c.dataset.tp !== f; });
  }));
</script>

<style>
  .r-hero { padding-block: clamp(40px, 7vw, 88px) 24px; display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: clamp(24px, 5vw, 64px); align-items: end; }
  .r-hero-copy { display: grid; gap: 18px; }
  .r-hero h1 { font-size: clamp(2.2rem, 4.8vw, 3.8rem); }
  .route { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .route li > a, .route li.here { display: flex; gap: 14px; align-items: center; padding: 12px 14px; border-radius: 12px; border: 1px solid var(--line); text-decoration: none; transition: border-color var(--t-fast), box-shadow var(--t-base) var(--ease), transform var(--t-fast) var(--ease); }
  .route li.here { background: var(--blush-2); border-color: var(--pink); }
  .route li > a:hover { border-color: var(--pink-mid); box-shadow: var(--shadow); transform: translateX(2px); }
  .route span { width: 28px; height: 28px; flex: none; border-radius: 50%; display: grid; place-items: center; font-weight: 900; font-size: 0.8rem; background: var(--line-2); color: var(--ink-2); }
  .route .here span { background: var(--accent); color: var(--accent-ink); }
  .route div { display: grid; }
  .route small { color: var(--ink-2); font-size: 0.85rem; }
  @media (max-width: 860px) { .r-hero { grid-template-columns: 1fr; } }

  .jump { display: flex; gap: 6px; flex-wrap: wrap; padding-block: 12px 0; }
  .jump a { font-size: 0.85rem; font-weight: 700; color: var(--ink-2); text-decoration: none; padding: 6px 12px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line-2); }
  .jump a:hover { color: var(--accent); border-color: var(--pink); }

  .r-sec { padding-top: clamp(48px, 7vw, 88px); }
  .r-head { display: grid; gap: 6px; margin-bottom: 24px; max-width: 70ch; }
  .r-head h2 { font-size: clamp(1.6rem, 2.8vw, 2.2rem); }

  .files { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .file { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .file-media { aspect-ratio: 16 / 10; background: var(--blush-2); overflow: hidden; }
  .file-media img { width: 100%; height: 100%; object-fit: cover; }
  .file-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .file-body p { color: var(--ink-2); font-size: 0.93rem; }
  .file-body ul { margin: 0; padding-left: 1.1em; color: var(--ink-2); font-size: 0.88rem; display: grid; gap: 3px; flex: 1; }
  .file-body .btn { align-self: start; }
  .soon { align-self: start; color: var(--ink-3); border: 1px dashed var(--line); border-radius: 999px; padding: 4px 12px; font-weight: 700; }
  @media (max-width: 960px) { .files { grid-template-columns: 1fr; } .file { flex-direction: row; } .file-media { flex: 0 0 38%; aspect-ratio: auto; } }
  @media (max-width: 600px) { .file { flex-direction: column; } .file-media { aspect-ratio: 16 / 10; } }

  .method { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .dd { width: 100%; border-radius: var(--radius); background: var(--surface-2); position: sticky; top: calc(var(--head-h) + 20px); }
  .phases { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .phases > li { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line-2); }
  .phases > li > img { width: 48px; height: 48px; object-fit: contain; }
  .phases h3 { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .dir { font-size: 0.7rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .phases .tag { color: var(--accent); font-style: italic; margin: 4px 0 8px; font-size: 0.95rem; }
  .phases ul { margin: 0; padding-left: 1.1em; color: var(--ink-2); font-size: 0.92rem; display: grid; gap: 2px; }
  @media (max-width: 820px) { .method { grid-template-columns: 1fr; } .dd { position: static; max-width: 520px; } }

  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
  .filters button { border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 5px 12px; font-size: 0.82rem; font-weight: 700; color: var(--ink-2); cursor: pointer; transition: background var(--t-fast), color var(--t-fast), border-color var(--t-fast); }
  .filters button:hover { border-color: var(--pink-mid); }
  .filters button[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .tpls { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; }
  .tpls a { display: grid; gap: 6px; align-content: start; height: 100%; padding: 10px; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; transition: border-color var(--t-fast), box-shadow var(--t-base) var(--ease), transform var(--t-base) var(--ease); }
  .tpls a:hover { border-color: var(--pink); box-shadow: var(--shadow); transform: translateY(-2px); }
  .tpl-media { aspect-ratio: 4 / 3; background: var(--blush-2); border-radius: 8px; overflow: hidden; display: block; }
  .tpl-media img { width: 100%; height: 100%; object-fit: contain; }
  .tpls strong { font-size: 0.9rem; line-height: 1.3; }
  .tpls small { color: var(--ink-3); font-size: 0.76rem; }

  .pcards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .pcards li { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; }
  .pcards img { aspect-ratio: 4 / 3; width: 100%; object-fit: contain; background: var(--blush-2); }
  .pcards div { padding: 14px 16px 16px; display: grid; gap: 4px; }
  .pcards .line { color: var(--accent); font-style: italic; font-size: 0.9rem; }
  .pcards p { color: var(--ink-2); font-size: 0.88rem; }
  @media (max-width: 960px) { .pcards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .pcards { grid-template-columns: 1fr; } }

  .past { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; text-decoration: none; transition: box-shadow var(--t-base) var(--ease), border-color var(--t-base); }
  .past:hover { box-shadow: var(--shadow-lift); border-color: var(--pink); }
  .past img { width: 100%; height: 100%; object-fit: cover; min-height: 220px; }
  .past > div { padding: clamp(20px, 3vw, 36px); display: grid; gap: 10px; align-content: center; }
  .past h3 { font-size: 1.6rem; font-weight: 400; }
  .past .go { font-weight: 700; color: var(--accent); }
  @media (max-width: 720px) { .past { grid-template-columns: 1fr; } }
  .more { margin-top: 18px; }
</style>
